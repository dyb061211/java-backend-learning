<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="learning.web.product.ProductMapper">
    <select id="findStockBySku" resultType="java.lang.Integer">
        SELECT stock
        FROM products
        WHERE sku=#{sku}
    </select>

    <resultMap id="ProductResultMap"
               type="learning.web.product.Product"
               autoMapping="false">
        <constructor>
            <arg column="sku" javaType="string"/>
            <arg column="name" javaType="string"/>
            <arg column="stock" javaType="_int"/>
        </constructor>
    </resultMap>

    <select id="findProductBySku" resultMap="ProductResultMap">
        SELECT sku,name,stock
        FROM products
        WHERE sku=#{sku}
    </select>

    <insert id="insertProduct">
        INSERT INTO products(sku,name,stock)
        VALUES(#{sku},#{name},#{stock})
    </insert>

    <update id="updateProduct">
        UPDATE products
        set name=#{name},
            stock=#{stock}
        WHERE sku=#{sku}
    </update>

    <delete id="deleteProduct">
        DELETE FROM products
        WHERE sku=#{sku}
    </delete>

    <select id="listProductById" resultMap="ProductResultMap">
        SELECT sku,name,stock
        FROM products
        ORDER BY id ASC
        LIMIT #{limit}
    </select>

    <select id="listProductBySku" resultMap="ProductResultMap">
        SELECT sku,name,stock
        FROM products
        ORDER BY sku ASC
        LIMIT #{limit}
    </select>

    <insert id="insertChangeLog">
        INSERT INTO product_change_log
            (sku,old_name,new_name,old_stock,new_stock)
        VALUES(#{sku},#{oldName},#{newName},#{oldStock},#{newStock})
    </insert>

    <select id="findProductForUpdate" resultMap="ProductResultMap">
        SELECT sku,name,stock
        FROM products
        WHERE sku=#{sku}
        FOR UPDATE
    </select>
</mapper>